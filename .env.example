# ==========================================
# CLAYPRESSO PRODUCTION ENVIRONMENT CONFIGURATION
# ==========================================

# 1. APPLICATION & ENVIRONMENT
NODE_ENV="production"
PORT=3000
NEXT_PUBLIC_APP_URL="https://claypresso.com"
ADMIN_ALERT_EMAIL="orders@claypresso.com"

# 2. DATABASE
# Local development SQLite:
DATABASE_URL="file:./dev.db"
# Production PostgreSQL (e.g. Supabase, Neon, AWS RDS):
# DATABASE_URL="postgresql://clay_user:SECURE_PASSWORD@db.example.com:5432/claypresso?schema=public&sslmode=require"

# 3. AUTHENTICATION & JWT SESSIONS
# Generate using: openssl rand -base64 32
JWT_SECRET="replace_with_a_secure_32_character_random_secret_in_production"
AUTH_SECRET="replace_with_a_secure_32_character_random_secret_in_production"
AUTH_COOKIE_NAME="claypresso_auth_token"
AUTH_TOKEN_EXPIRY="7d"

# 4. PAYMENT GATEWAY (RAZORPAY INDIA)
# Required for live UPI, RuPay, Visa, Mastercard, and NetBanking payments
# Retrieve from Razorpay Dashboard -> Settings -> API Keys & Webhooks
NEXT_PUBLIC_RAZORPAY_KEY_ID=""
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
# When keys are left blank, Claypresso runs in sandbox testing mode without charging cards

# 5. OBJECT & FILE STORAGE
# Supported drivers: "local" | "s3"
STORAGE_DRIVER="local"
# If using AWS S3 / Cloudflare R2:
# S3_BUCKET="claypresso-media"
# AWS_REGION="ap-south-1"
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""
# S3_ENDPOINT=""

# 6. TRANSACTIONAL NOTIFICATIONS (EMAIL)
# Using Resend API (Recommended):
RESEND_API_KEY=""
EMAIL_FROM="Claypresso Studio <orders@claypresso.com>"

# Or Standard SMTP:
# EMAIL_SERVER_HOST="smtp.mailgun.org"
# EMAIL_SERVER_PORT=587
# EMAIL_SERVER_USER="postmaster@mg.claypresso.com"
# EMAIL_SERVER_PASSWORD=""

# 7. WHATSAPP BUSINESS NOTIFICATIONS
# Meta WhatsApp Cloud API credentials
# Retrieve from developers.facebook.com -> WhatsApp -> API Setup
WHATSAPP_API_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_TEMPLATE_NAMESPACE=""

# 8. SHIPPING LOGISTICS CONFIGURATION
# Default values can also be managed directly in /admin/settings
FREE_SHIPPING_THRESHOLD=500
STANDARD_SHIPPING_FEE=60
